{
  "name": "fauxshield",
  "version": "0.1.0",
  "description": "Node.js and TypeScript SDK for the FauxShield anti-counterfeit platform: products, serialized units, verifications, and the fraud queue.",
  "keywords": [
    "fauxshield",
    "anti-counterfeit",
    "provenance",
    "traceability",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tope-olajide/fauxshield.git",
    "directory": "fauxshield_node"
  },
  "homepage": "https://github.com/tope-olajide/fauxshield#readme",
  "bugs": {
    "url": "https://github.com/tope-olajide/fauxshield/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node tools/generate.mjs",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
